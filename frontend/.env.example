# Backend origin for both GET /advice and the /ask WebSocket (src/api/advice.ts,
# src/api/ask.ts). Only needed for a hosted deployment (e.g. Render Static Site)
# pointed at a separately-deployed backend -- local dev (`npm run dev`) falls back
# to http://127.0.0.1:8000 when this is unset.
#
# Vite only exposes env vars prefixed VITE_ to client code -- don't rename this
# without keeping that prefix.
VITE_API_URL=http://127.0.0.1:8000
