# secrets
.env
*.pem
*.key

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# node
node_modules/
dist/
.vite/

# rust / tauri
desktop/src-tauri/target/
desktop/src-tauri/gen/

# db / embedded postgres data -- DEFAULT_PGDATA in backend/app/db_migrate.py
# resolves to the repo root (../.. from backend/app/), not backend/, so the
# ignore rule needs to match there too.
.pgdata/
*.sqlite3

# models / large artifacts (fine-tuned weights, GGUF quantized models)
backend/app/llm/checkpoints/
backend/app/finetune/artifacts/
*.gguf
*.safetensors

# generated fine-tuning Q&A data (regenerate via app.finetune.qa_generation)
backend/app/finetune/data/
*.bin

# datasets pulled from Riot (do not commit raw match data)
backend/app/data_pipeline/raw/
backend/app/data_pipeline/cache/

# logs
*.log

# OS
.DS_Store
Thumbs.db

# claude code
.claude/

