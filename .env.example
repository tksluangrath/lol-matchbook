# Riot Developer API key. Get one at https://developer.riotgames.com/
# Personal/dev keys expire every 24h and are rate-limited (~100 req/2min) --
# fine for testing the pipeline, not for a full data pull. See docs/build-plan.md Phase 0
# re: applying for a production key and the public-dataset fallback while it's pending.
RIOT_API_KEY=

# Riot platform routing value for match/summoner lookups, e.g. na1, euw1, kr.
RIOT_PLATFORM=na1
# Riot regional routing value for Match-V5, e.g. americas, europe, asia.
RIOT_REGION=americas

# Local Postgres (managed by pgserver -- see docs/tech-stack.md). Defaults match
# pgserver's typical local invocation; change only if you're running Postgres
# as a separate system service instead.
DATABASE_URL=postgresql+psycopg://localhost:5432/lol_matchup_copilot

# Path to the fine-tuned LoRA adapter used for precompute generation (Phase 2/3).
# Leave blank until a fine-tune pass has actually produced one.
ADAPTER_PATH=

# Path to the quantized GGUF model used for the live follow-up chat path (Phase 4).
FOLLOWUP_MODEL_PATH=

# Backend bind address -- keep this on localhost only, never 0.0.0.0.
# See docs/testing-strategy.md security-boundary notes.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
